{
    "dart.lineLength": 120,
    "dart.flutterTestAdditionalArgs": [
        "--dart-define-from-file=.env.dev"
    ],
    "[dart]": {
        "editor.rulers": [
            120
        ],
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit"
        }
    },
    "search.exclude": {
        "**/build": true,
        "**/.dart_tool": true,
        "lib/core/i18n/strings*.g.dart": true
    },
    "files.watcherExclude": {
        "**/build/**": true,
        "**/.dart_tool/**": true
    }
}